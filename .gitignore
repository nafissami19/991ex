assets/fonts/
assets/images/faceplate*.png
assets/images/status_bar_*.png
assets/images/indicators/
assets/images/*screenshot*.png
assets/images/*preview*.png

# Reference PDFs (HARD RULE 2)
docs/reference/*.pdf
